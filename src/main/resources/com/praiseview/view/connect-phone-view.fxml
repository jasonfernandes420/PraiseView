<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.praiseview.controller.ConnectPhoneController">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="Connect Your Phone" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <!-- Download App Instructions -->
    <VBox spacing="6" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-color: #f9f9f9; -fx-padding: 10;">
        <Label text="Step 1: Download the App" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
        <Label text="Download PraiseView Companion from Google Play Store:" wrapText="true" style="-fx-font-size: 10px;"/>
        <Hyperlink text="https://play.google.com/store/apps/details?id=com.praiseview.companion" 
                   fx:id="playStoreLink" style="-fx-font-size: 10px;"/>
        <Label text="Or search 'PraiseView Companion' in Google Play Store." 
               wrapText="true" style="-fx-font-size: 9px; -fx-text-fill: #666666;"/>
    </VBox>

    <!-- QR Code Section -->
    <VBox spacing="6" alignment="CENTER">
        <Label text="Step 2: Scan QR Code" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
        <Label text="Open the app and scan this code:" wrapText="true" alignment="CENTER" style="-fx-font-size: 10px;"/>
        <ImageView fx:id="qrCodeImageView" fitWidth="280" fitHeight="280" preserveRatio="true"/>
    </VBox>

    <!-- Connection Status -->
    <VBox spacing="4" alignment="CENTER">
        <Label text="Step 3: Connect" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
        <Label fx:id="connectionStatusLabel" text="Waiting for phone connection..." wrapText="true" alignment="CENTER"
               style="-fx-text-fill: #8a5a00; -fx-font-weight: bold; -fx-font-size: 10px;"/>
        <Label fx:id="connectionDetailsLabel" text="Details: IP: --, Port: --, App: PraiseView" 
               wrapText="true" alignment="CENTER" style="-fx-font-size: 9px; -fx-text-fill: #666666;"/>
    </VBox>
</VBox>
