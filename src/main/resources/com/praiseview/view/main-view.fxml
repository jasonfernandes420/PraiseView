<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.TextFlow?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.praiseview.controller.MainController"
            styleClass="root">

    <!-- Top Toolbar -->
    <top>
        <HBox spacing="12" padding="10" styleClass="toolbar">
            <Button text="New Service" fx:id="newServiceButton"/>
            <Button text="Save Service" fx:id="saveServiceButton"/>
            <Button text="Load Service" fx:id="loadServiceButton"/>
            <Button text="Export PDF" fx:id="exportButton"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Mass Planner" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        </HBox>
    </top>

    <!-- Left: Service Planner -->
    <left>
        <VBox prefWidth="340" spacing="8" padding="10">
            <Label text="Service Order" styleClass="header"/>
            <ListView fx:id="servicePlannerList" prefHeight="500"/>
            <Button text="Add Item" fx:id="addItemButton"/>
        </VBox>
    </left>

    <!-- Center: Editor + Live Preview -->
    <center>
        <SplitPane dividerPositions="0.55" orientation="VERTICAL">
            <!-- Top: Item Editor -->
            <VBox spacing="8" padding="12">
                <Label text="Item Editor" styleClass="header"/>
                <TextArea fx:id="itemEditorArea" promptText="Edit announcement, reading, or lyrics here..." prefHeight="180"/>
            </VBox>

            <!-- Bottom: Live Projection Preview -->
            <VBox spacing="8" padding="12">
                <Label text="Live Projection Preview (What will be shown)" styleClass="header"/>
                <StackPane fx:id="livePreviewPane" style="-fx-background-color: #1a1a1a;" prefHeight="320">
                    <TextFlow fx:id="livePreviewText" />
                </StackPane>
            </VBox>
        </SplitPane>
    </center>

    <!-- Right: Next Slide + Controls -->
    <right>
        <VBox prefWidth="280" spacing="15" padding="12">
            <Label text="Next Item" styleClass="header"/>
            <StackPane style="-fx-background-color: #252525;" prefHeight="210">
                <TextFlow fx:id="nextSlidePreview" />
            </StackPane>

            <Separator/>

            <Button fx:id="blackoutButton" text="⏹ Blackout Screen" prefWidth="260"/>
            <Button fx:id="clearButton" text="Clear Screen" prefWidth="260"/>
            <ToggleButton fx:id="aiToggle" text="🎤 AI Auto Advance" prefWidth="260"/>

            <Label text="Font Size"/>
            <Slider fx:id="fontSlider" min="35" max="130" value="65" showTickMarks="true"/>
        </VBox>
    </right>

    <!-- Bottom: Library -->
    <bottom>
        <TabPane prefHeight="260">
            <Tab text="Songs">
                <ListView fx:id="songLibraryList"/>
            </Tab>
            <Tab text="Bible"/>
            <Tab text="Images"/>
            <Tab text="Videos"/>
            <Tab text="Announcements"/>
        </TabPane>
    </bottom>

</BorderPane>
