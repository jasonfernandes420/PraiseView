<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.media.MediaView?> <!-- Added for MediaView -->

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.praiseview.controller.MainController"
            styleClass="root"
            prefWidth="1480" prefHeight="920">

    <!-- Top Menu -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="New Service" onAction="#newService"/>
                <MenuItem text="Save Service" onAction="#saveService"/>
                <MenuItem text="Load Service" onAction="#importService"/>
                <SeparatorMenuItem/>
                <MenuItem text="Export Songs..." onAction="#exportSongs"/>
                <MenuItem text="Export Prayers..." onAction="#exportPrayers"/>
                <SeparatorMenuItem/>
                <MenuItem text="Theme Editor..." onAction="#openThemeEditor"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#exitApp"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#showAbout"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- Left: Mass Planner / Service Order -->
    <left>
        <VBox prefWidth="340" spacing="8" VBox.vgrow="ALWAYS">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Mass Planner - Service Order" styleClass="header"/>
            <ListView fx:id="servicePlannerList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- Center: Stage View + Controls -->
    <center>
        <HBox spacing="10" alignment="TOP_CENTER">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <!-- Stage View and Controls -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Stage View (Current Projection)" styleClass="header"/>
                <!-- The livePreviewPane will now contain its own title and textflow -->
                <StackPane fx:id="livePreviewPane" style="-fx-background-color: #0f0f0f;" VBox.vgrow="ALWAYS" prefHeight="500" prefWidth="800">
                    <!-- Container for text-based content (Song, Prayer, Announcement) -->
                    <VBox fx:id="liveTextContentContainer" alignment="CENTER" spacing="10" StackPane.alignment="CENTER">
                        <Label fx:id="stageViewTitle" style="-fx-text-fill: #ffd700; -fx-font-size: 24px;"/>
                        <TextFlow fx:id="livePreviewText" textAlignment="CENTER" style="-fx-padding: 10px;"/>
                    </VBox>

                    <!-- ImageView for displaying image previews -->
                    <ImageView fx:id="liveImageView" fitWidth="${livePreviewPane.width}" fitHeight="${livePreviewPane.height}"
                               preserveRatio="true" visible="false" managed="false" StackPane.alignment="CENTER"/>

                    <!-- MediaView for displaying video previews -->
                    <MediaView fx:id="liveMediaView" fitWidth="${livePreviewPane.width}" fitHeight="${livePreviewPane.height}"
                               visible="false" managed="false" StackPane.alignment="CENTER"/>

                    <!-- Placeholder for PPT previews (text-based for now) -->
                    <VBox fx:id="livePptPlaceholderContainer" alignment="CENTER" spacing="20" visible="false" managed="false" StackPane.alignment="CENTER">
                        <Label text="PPT Preview (Placeholder)" style="-fx-font-size: 24px; -fx-text-fill: #ffd700;"/>
                        <Text fx:id="livePptPlaceholderText" style="-fx-font-size: 16px; -fx-text-fill: white;" textAlignment="CENTER"/>
                    </VBox>
                </StackPane>

                <!-- Projection Controls -->
                <HBox alignment="CENTER" spacing="10" VBox.vgrow="NEVER">
                    <Button fx:id="prevVerseButton" text="Previous">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/arrow_left.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="projectButton" text="Project">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/play.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="blackoutButton" text="Blackout">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/blackout.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="clearButton" text="Clear">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/clear.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="nextVerseButton" text="Next">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/arrow_right.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Video Controls -->
                <HBox alignment="CENTER" spacing="10" VBox.vgrow="NEVER">
                    <Button fx:id="videoRewindButton" text="⏪ -10s" onAction="#onVideoRewind" disable="true">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/rewind.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="videoPlayPauseButton" text="⏯️ Play/Pause" onAction="#playPauseVideo" disable="true">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/play_pause.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="videoForwardButton" text="⏩ +10s" onAction="#onVideoForward" disable="true">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../images/forward.png"/> <!-- Placeholder for icon -->
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Current Song Verses List (moved from right) -->
            <VBox prefWidth="280" spacing="8" HBox.hgrow="NEVER">
                <Label text="Current Item Verses/Pages" styleClass="header"/>
                <ListView fx:id="currentSubItemList" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <!-- Right: Theme Editor (repurposed from old controls) -->
    <right>
        <TabPane prefWidth="280" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Theme Editor">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Theme Settings (Placeholder)" styleClass="header"/>
                    <Label text="Font Size:"/>
                    <Slider min="10" max="100" value="62" showTickLabels="true" showTickMarks="true" majorTickUnit="10" minorTickCount="5"/>
                    <Label text="Background Color:"/>
                    <ColorPicker/>
                    <Button text="Save Theme"/>
                </VBox>
            </Tab>
            <!-- Add other tabs if needed in the future -->
        </TabPane>
    </right>

    <!-- Bottom: Library -->
    <bottom>
        <TabPane prefHeight="260">
            <Tab text="Songs">
                <VBox>
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <TextField fx:id="searchField" promptText="Search songs..."/>
                    <ListView fx:id="songLibraryList" prefHeight="220"/>
                    <HBox spacing="8">
                        <Button fx:id="addSongButton" text="➕ Add New Song" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="editSongButton" text="✎ Edit Selected" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Prayers">
                <VBox><padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <HBox spacing="8">
                        <Button fx:id="addPrayerButton" text="➕ Add New Prayer" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="editPrayerButton" text="✎ Edit Selected" HBox.hgrow="ALWAYS" onAction="#editSelectedPrayer"/>
                    </HBox>
                    <ListView fx:id="prayerList" prefHeight="220"/>
                </VBox>
            </Tab>
            <Tab text="Bible"/>
            <Tab text="Images">
                <VBox>
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <HBox spacing="8">
                        <Button fx:id="openImageButton" text="📂 Open Images" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="clearImageButton" text="🗑️ Clear Images" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ListView fx:id="imageList" VBox.vgrow="ALWAYS" prefHeight="220"/>
                </VBox>
            </Tab>
            <Tab text="Videos">
                <VBox>
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <HBox spacing="8">
                        <Button fx:id="openVideoButton" text="🎬 Open Videos" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="clearVideoButton" text="🗑️ Clear Videos" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ListView fx:id="videoList" VBox.vgrow="ALWAYS" prefHeight="220"/>
                </VBox>
            </Tab>
            <Tab text="PPT">
                <VBox>
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <HBox spacing="8">
                        <Button fx:id="openPptButton" text="📊 Open PPTs" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="clearPptButton" text="🗑️ Clear PPTs" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ListView fx:id="pptList" VBox.vgrow="ALWAYS" prefHeight="220"/>
                </VBox>
            </Tab>
        </TabPane>
    </bottom>

</BorderPane>
