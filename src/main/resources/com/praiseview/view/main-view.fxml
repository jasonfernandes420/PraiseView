<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.TextFlow?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.praiseview.controller.MainController"
            styleClass="root">

    <!-- Top Menu -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="New Service" onAction="#newService"/>
                <MenuItem text="Save Service" onAction="#saveService"/>
                <MenuItem text="Import JSON" onAction="#importService"/>
                <MenuItem text="Export JSON" onAction="#exportService"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#exitApp"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#showAbout"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- Left: Mass Planner / Service Order -->
    <left>
        <VBox prefWidth="340" spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Mass Planner - Service Order" styleClass="header"/>
            <ListView fx:id="servicePlannerList" prefHeight="520"/>
        </VBox>
    </left>

    <!-- Center: Editor + Live Preview -->
    <center>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL">
            <!-- Editor -->
            <VBox spacing="8">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="Item Editor" styleClass="header"/>
                <TextArea fx:id="itemEditorArea" promptText="Type announcement or edit lyrics here..." prefHeight="180"/>
            </VBox>

            <!-- Live Projection Preview -->
            <VBox spacing="8">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="Live Projection Preview" styleClass="header"/>
                <StackPane fx:id="livePreviewPane" style="-fx-background-color: #1a1a1a;" prefHeight="320">
                    <TextFlow fx:id="livePreviewText"/>
                </StackPane>
            </VBox>
        </SplitPane>
    </center>

    <!-- Right: Controls -->
    <right>
        <VBox prefWidth="280" spacing="12">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Live Controls" styleClass="header"/>
            <Button fx:id="projectButton" text="▶ Start Projection" prefWidth="260"/>
            <Button fx:id="blackoutButton" text="Blackout Screen" prefWidth="260"/>
            <Button fx:id="clearButton" text="Clear Screen" prefWidth="260"/>
            <Button fx:id="nextVerseButton" text="Next Verse →"/>
            <Button fx:id="prevVerseButton" text="← Previous Verse"/>
        </VBox>
    </right>

    <!-- Bottom: Library -->
    <bottom>
        <TabPane prefHeight="260">
            <Tab text="Songs">
                <VBox>
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    <TextField fx:id="searchField" promptText="Search songs..."/>
                    <ListView fx:id="songLibraryList" prefHeight="220"/>
                    <Button fx:id="addSongButton" text="Add New Song"/>
                </VBox>
            </Tab>
            <Tab text="Bible"/>
            <Tab text="Images"/>
            <Tab text="Videos"/>
        </TabPane>
    </bottom>

</BorderPane>